+    ident = {'lean': pins['lean'], 'workspace': digest(ws),
+             'checker_sha256': hashlib.sha256((src / 'checker.py').read_bytes()).hexdigest(),
+             'replay_sha256': hashlib.sha256((src / 'theory_package.py').read_bytes()).hexdigest()}
+    return digest(ident)
