+def quadratic_upper(n):
+    """The largest m with 4m^2 <= n^2 (n - 1) + 2nm (exact integers): the bound the checked
+    theorem gives for a C4-free subgraph of any host on n vertices."""
+    if n <= 0:
+        return 0
+    lo, hi = 0, n * n
+    while lo < hi:
+        mid = (lo + hi + 1) // 2
+        if 4 * mid * mid <= n * n * (n - 1) + 2 * n * mid:
+            lo = mid
+        else:
+            hi = mid - 1
+    return lo
