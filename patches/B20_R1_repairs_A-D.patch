+    def test_expensive_policy_preparation_and_choice_are_charged(self):
+        class Slow(RS.Fixed):
+            name = 'slow'
+
+            def reset(self, pool, dev):
+                t = time.process_time()
+                while time.process_time() - t < 0.3:
+                    pass
+                super().reset(pool, dev)
+
+            def choose(self, untried):
+                t = time.process_time()
