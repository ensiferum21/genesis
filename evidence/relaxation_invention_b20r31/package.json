   "name": "GTDefs",
   "source": "import Mathlib.Data.Finset.Powerset\n\nnamespace GT\n\n/-- Edge sets: ordered pairs (u, v), read as the edge {u, v}. Hosts list each edge once, with u < v. -/\nabbrev Edges := Finset (ℕ × ℕ)\n\n/-- No three edges (a, b), (b, c), (a, c). -/\ndef TriangleFree (S : Edges) : Prop :=\n  ∀ e ∈ S, ∀ f ∈ S, ∀ g ∈ S, ¬ (e.1 = g.1 ∧ e.2 = f.1 ∧ f.2 = g.2)\n\ninstance (S : Edges) : Decidable (TriangleFree S) := by\n  unfold TriangleFree; infer_instance\n\nend GT\n",
   "source_sha256": "34a84d4f227cbf5a95012a37a9f263f14ca419a4959be42c674d8abc47c9e3a7",
   "trusted": true
  },
  {
   "name": "PCDefs",
   "source": "import GTDefs\n\nnamespace PC\n\n/-- 0/1 adjacency of an edge set, either orientation (B20_R31, generated:pattern-inequalities-v1). -/\ndef adj (S : GT.Edges) (u v : ℕ) : ℕ := if (u, v) ∈ S ∨ (v, u) ∈ S then 1 else 0\n\nend PC\n",
   "source_sha256": "f077048e259ca3a99bd240cb6650bf5e6fc8472b1d566b4c184c179f7733a7a7",
   "trusted": true
  },
  {
   "name": "PCConj",
   "source": "import GTDefs\nimport PCDefs\nset_option linter.unusedVariables false\n\nnamespace PCConj\n/-- Generated conjecture `pc_adj_le_one` (generated:pattern-inequalities-v1). -/\ndef pc_adj_le_one : Prop := ∀ (S : GT.Edges) (u : ℕ) (v : ℕ), PC.adj S u v ≤ 1\n/-- Generated conjecture `pc_bridge` (generated:pattern-inequalities-v1). -/\ndef pc_bridge : Prop := ∀ (S : GT.Edges) (hS : GT.TriangleFree S) (hH : ∀ e ∈ S, e.1 < e.2) (x : ℕ) (y : ℕ) (z : ℕ), PC.adj S x y + PC.adj S y z + PC.adj S x z ≤ 2\n/-- Generated conjecture `pc_pat5_10_01020304121314232434` (generated:pattern-inequalities-v1). -/\ndef pc_pat5_10_01020304121314232434 : Prop := ∀ (S : GT.Edges) (hS : GT.TriangleFree S) (hH : ∀ e ∈ S, e.1 < e.2) (v0 : ℕ) (v1 : ℕ) (v2 : ℕ) (v3 : ℕ) (v4 : ℕ), PC.adj S v0 v1 + PC.adj S v0 v2 + PC.adj S v0 v3 + PC.adj S v0 v4 + PC.adj S v1 v2 + PC.adj S v1 v3 + PC.adj S v1 v4 + PC.adj S v2 v3 + PC.adj S v2 v4 + PC.adj S v3 v4 ≤ 6\n/-- Generated conjecture `pc_pat6_10_01040512152325343545` (generated:pattern-inequalities-v1). -/\ndef pc_pat6_10_01040512152325343545 : Prop := ∀ (S : GT.Edges) (hS : GT.TriangleFree S) (hH : ∀ e ∈ S, e.1 < e.2) (v0 : ℕ) (v1 : ℕ) (v2 : ℕ) (v3 : ℕ) (v4 : ℕ) (v5 : ℕ), PC.adj S v0 v1 + PC.adj S v0 v4 + PC.adj S v0 v5 + PC.adj S v1 v2 + PC.adj S v1 v5 + PC.adj S v2 v3 + PC.adj S v2 v5 + PC.adj S v3 v4 + PC.adj S v3 v5 + PC.adj S v4 v5 ≤ 7\nend PCConj\n",
