  {
   "name": "PCP1",
   "source": "import GTDefs\nimport PCDefs\nimport PCConj\nnamespace PCP1\ntheorem proof : PCConj.pc_adj_le_one := by\n  unfold PCConj.pc_adj_le_one\n  intro S u v\n  unfold PC.adj\n  split <;> omega\nend PCP1\n",
