   "source": "import GTDefs\nimport PCDefs\nimport PCConj\nimport PCP1\nnamespace PCP2\ntheorem proof : PCConj.pc_bridge := by\n  unfold PCConj.pc_bridge\n  intro S hS hH x y z\n  unfold PC.adj\n  split_ifs with h1 h2 h3 <;> try omega\n  exfalso\n  unfold GT.TriangleFree at hS\n  rcases h1 with h1 | h1 <;> rcases h2 with h2 | h2 <;> rcases h3 with h3 | h3\n  all_goals first\n    | exact hS _ h1 _ h2 _ h3 ⟨rfl, rfl, rfl⟩\n    | exact hS _ h1 _ h3 _ h2 ⟨rfl, rfl, rfl⟩\n    | exact hS _ h2 _ h1 _ h3 ⟨rfl, rfl, rfl⟩\n    | exact hS _ h2 _ h3 _ h1 ⟨rfl, rfl, rfl⟩\n    | exact hS _ h3 _ h1 _ h2 ⟨rfl, rfl, rfl⟩\n    | exact hS _ h3 _ h2 _ h1 ⟨rfl, rfl, rfl⟩\n    | (have o1 := hH _ h1; have o2 := hH _ h2; have o3 := hH _ h3; (try simp only at o1 o2 o3); omega)\nend PCP2\n",
