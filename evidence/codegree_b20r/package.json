 "modules": [
  {
   "name": "GTDefs",
   "source": "import Mathlib.Data.Finset.Powerset\n\nnamespace GT\n\n/-- Edge sets: ordered pairs (u, v), read as the edge {u, v}. Hosts list each edge once, with u < v. -/\nabbrev Edges := Finset (ℕ × ℕ)\n\n/-- No three edges (a, b), (b, c), (a, c). -/\ndef TriangleFree (S : Edges) : Prop :=\n  ∀ e ∈ S, ∀ f ∈ S, ∀ g ∈ S, ¬ (e.1 = g.1 ∧ e.2 = f.1 ∧ f.2 = g.2)\n\ninstance (S : Edges) : Decidable (TriangleFree S) := by\n  unfold TriangleFree; infer_instance\n\nend GT\n",
   "source_sha256": "34a84d4f227cbf5a95012a37a9f263f14ca419a4959be42c674d8abc47c9e3a7",
   "trusted": true
  },
  {
   "name": "G4Defs",
   "source": "import GTDefs\n\nnamespace G4\n\n/-- Domain contract (c4_host_v2): u and v are joined in S, in either orientation. -/\ndef adj (S : GT.Edges) (u v : ℕ) : Prop := (u, v) ∈ S ∨ (v, u) ∈ S\n\ninstance (S : GT.Edges) (u v : ℕ) : Decidable (adj S u v) := by\n  unfold adj; infer_instance\n\ndef verts (S : GT.Edges) : Finset ℕ := S.image Prod.fst ∪ S.image Prod.snd\n\n/-- No 4-cycle a-b-c-d-a with a ≠ c and b ≠ d. -/\ndef C4Free (S : GT.Edges) : Prop :=\n  ∀ a ∈ verts S, ∀ b ∈ verts S, ∀ c ∈ verts S, ∀ d ∈ verts S,\n    a ≠ c → b ≠ d → ¬ (adj S a b ∧ adj S b c ∧ adj S c d ∧ adj S d a)\n\ninstance (S : GT.Edges) : Decidable (C4Free S) := by\n  unfold C4Free; infer_instance\n\nend G4\n",
   "source_sha256": "bf94fb5d73cc9d32e1e11167df93df0ca356b3f1a6de0b050a8efe53bae7987b",
   "trusted": true
  },
  {
   "name": "CDDefs",
   "source": "import GTDefs\nimport G4Defs\n\nnamespace CD\n\n/-- Common neighbours of u and v in S: the vertices of S adjacent to both. -/\ndef commonNbrs (S : GT.Edges) (u v : ℕ) : Finset ℕ :=\n  (G4.verts S).filter (fun w => G4.adj S u w ∧ G4.adj S v w)\n\n/-- Every pair of distinct vertices of S has at most one common neighbour (codegree ≤ 1). -/\ndef CodegLeOne (S : GT.Edges) : Prop :=\n  ∀ u ∈ G4.verts S, ∀ v ∈ G4.verts S, u ≠ v → (commonNbrs S u v).card ≤ 1\n\nend CD\n",
   "source_sha256": "06155e156e7e26cc20e326fc15b555a4d0e3f1d81d2c432266654d586b0941a0",
   "trusted": true
  },
  {
   "name": "CDConj",
   "source": "import GTDefs\nimport G4Defs\nimport CDDefs\nset_option linter.unusedVariables false\n\nnamespace CDConj\n/-- Generated conjecture `codeg_iff_c4free` (builder-written (CRPD-2): known equivalence, stated over the repository definitions). -/\ndef codeg_iff_c4free : Prop := ∀ (S : GT.Edges), G4.C4Free S ↔ CD.CodegLeOne S\nend CDConj\n",
   "source_sha256": "f6858e3a452b6e4f0abef570ae476db464d9bb54ebc7f62bd3a4a6d2f934179b",
   "trusted": true
  },
  {
   "name": "CDP1",
   "source": "import GTDefs\nimport G4Defs\nimport CDDefs\nimport CDConj\nnamespace CDP1\ntheorem proof : CDConj.codeg_iff_c4free := by\n  unfold CDConj.codeg_iff_c4free\n  intro S\n  have symm : ∀ x y, G4.adj S x y → G4.adj S y x := by\n    intro x y h\n    unfold G4.adj at *\n    exact h.symm\n  unfold G4.C4Free CD.CodegLeOne\n  constructor\n  · intro h u hu v hv huv\n    by_contra hc\n    have hc2 : 1 < (CD.commonNbrs S u v).card := by omega\n    obtain ⟨b, hb, d, hd, hbd⟩ := Finset.one_lt_card.mp hc2\n    simp only [CD.commonNbrs, Finset.mem_filter] at hb hd\n    exact h u hu b hb.1 v hv d hd.1 huv hbd ⟨hb.2.1, symm _ _ hb.2.2, hd.2.2, symm _ _ hd.2.1⟩\n  · intro h a ha b hb c hc d hd hac hbd habcd\n    obtain ⟨h1, h2, h3, h4⟩ := habcd\n    have hcard : 1 < (CD.commonNbrs S a c).card := by\n      apply Finset.one_lt_card.mpr\n      refine ⟨b, ?_, d, ?_, hbd⟩\n      · simp only [CD.commonNbrs, Finset.mem_filter]\n        exact ⟨hb, h1, symm _ _ h2⟩\n      · simp only [CD.commonNbrs, Finset.mem_filter]\n        exact ⟨hd, symm _ _ h4, h3⟩\n    have := h a ha c hc hac\n    omega\nend CDP1\n",
   "source_sha256": "d864972b9fa2059a9c29db9818a6e0577043ad072228d2f0db440d135a42c502",
   "trusted": false
  }
 ],
