 "domain": "edge-set predicates",
 "modules": [
  {
   "name": "GTDefs",
   "source": "import Mathlib.Data.Finset.Powerset\n\nnamespace GT\n\n/-- Edge sets: ordered pairs (u, v), read as the edge {u, v}. Hosts list each edge once, with u < v. -/\nabbrev Edges := Finset (ℕ × ℕ)\n\n/-- No three edges (a, b), (b, c), (a, c). -/\ndef TriangleFree (S : Edges) : Prop :=\n  ∀ e ∈ S, ∀ f ∈ S, ∀ g ∈ S, ¬ (e.1 = g.1 ∧ e.2 = f.1 ∧ f.2 = g.2)\n\ninstance (S : Edges) : Decidable (TriangleFree S) := by\n  unfold TriangleFree; infer_instance\n\nend GT\n",
   "source_sha256": "34a84d4f227cbf5a95012a37a9f263f14ca419a4959be42c674d8abc47c9e3a7",
   "trusted": true
  },
  {
   "name": "HSDefs",
   "source": "import GTDefs\n\nnamespace HS\n\n/-- History predicate: every pair is listed as (u, v) with u < v. -/\ndef Simple (S : GT.Edges) : Prop := ∀ e ∈ S, e.1 < e.2\n\n/-- History predicate: every endpoint is below 8. -/\ndef Bounded8 (S : GT.Edges) : Prop := ∀ e ∈ S, e.1 < 8 ∧ e.2 < 8\n\ninstance (S : GT.Edges) : Decidable (Simple S) := by unfold Simple; infer_instance\ninstance (S : GT.Edges) : Decidable (Bounded8 S) := by unfold Bounded8; infer_instance\n\nend HS\n",
   "source_sha256": "fda70a92d2893b0470ae39d2918fca1b195e1db384d6fedbbc1950b51e65d5db",
   "trusted": true
  },
  {
   "name": "HSConj",
   "source": "import GTDefs\nimport HSDefs\nset_option linter.unusedVariables false\n\nnamespace HSConj\n/-- Generated conjecture `down_tf` (history). -/\ndef down_tf : Prop := ∀ (S : GT.Edges) (T : GT.Edges) (h1 : T ⊆ S) (h2 : GT.TriangleFree S), GT.TriangleFree T\n/-- Generated conjecture `down_simple` (history). -/\ndef down_simple : Prop := ∀ (S : GT.Edges) (T : GT.Edges) (h1 : T ⊆ S) (h2 : HS.Simple S), HS.Simple T\n/-- Generated conjecture `down_bounded` (history). -/\ndef down_bounded : Prop := ∀ (S : GT.Edges) (T : GT.Edges) (h1 : T ⊆ S) (h2 : HS.Bounded8 S), HS.Bounded8 T\n/-- Generated conjecture `inter_tf` (history). -/\ndef inter_tf : Prop := ∀ (S : GT.Edges) (T : GT.Edges) (h1 : GT.TriangleFree S), GT.TriangleFree (S ∩ T)\n/-- Generated conjecture `inter_simple` (history). -/\ndef inter_simple : Prop := ∀ (S : GT.Edges) (T : GT.Edges) (h1 : HS.Simple S), HS.Simple (S ∩ T)\nend HSConj\n",
   "source_sha256": "b51522fc7800b90635c57f6e77ae907ef1f30cf3054ccf078472d4ad0d5b5040",
   "trusted": true
  },
  {
   "name": "HSP1",
   "source": "import GTDefs\nimport HSDefs\nimport HSConj\nnamespace HSP1\ntheorem proof : HSConj.down_tf := by\n  unfold HSConj.down_tf\n  intro S T h1 h2\n  try unfold GT.TriangleFree at *\n  try unfold HS.Simple at *\n  try unfold HS.Bounded8 at *\n  intros\n  apply h2 <;> solve_by_elim\nend HSP1\n",
   "source_sha256": "ddc421076575f100d6715fd91f49704adcec23b975e526c99f3c8349b341cbf1",
   "trusted": false
  },
  {
   "name": "HSP2",
   "source": "import GTDefs\nimport HSDefs\nimport HSConj\nimport HSP1\nnamespace HSP2\ntheorem proof : HSConj.down_simple := by\n  unfold HSConj.down_simple\n  intro S T h1 h2\n  solve_by_elim [HSP1.proof]\nend HSP2\n",
   "source_sha256": "e4f4589f1f93190f3a4bc85189955589fd0c8ab87c4c8ace773b920b265acd8c",
   "trusted": false
  },
  {
   "name": "HSP3",
   "source": "import GTDefs\nimport HSDefs\nimport HSConj\nimport HSP1\nimport HSP2\nnamespace HSP3\ntheorem proof : HSConj.down_bounded := by\n  unfold HSConj.down_bounded\n  intro S T h1 h2\n  solve_by_elim [HSP1.proof, HSP2.proof]\nend HSP3\n",
   "source_sha256": "d49948c184280aa7b6c7b3e25eb53174f2700b2495873807d23554e3b0b2c5fe",
   "trusted": false
  },
  {
   "name": "HSP4",
   "source": "import GTDefs\nimport HSDefs\nimport HSConj\nimport HSP1\nimport HSP2\nimport HSP3\nnamespace HSP4\ntheorem proof : HSConj.inter_tf := by\n  unfold HSConj.inter_tf\n  intro S T h1\n  try unfold GT.TriangleFree at *\n  try unfold HS.Simple at *\n  try unfold HS.Bounded8 at *\n  aesop\nend HSP4\n",
   "source_sha256": "7a9a55e0de5b37462cee444d78b6b52464f058b54fdd1e886905559f2e0d8cd6",
   "trusted": false
  },
  {
   "name": "HSP5",
   "source": "import GTDefs\nimport HSDefs\nimport HSConj\nimport HSP1\nimport HSP2\nimport HSP3\nimport HSP4\nnamespace HSP5\ntheorem proof : HSConj.inter_simple := by\n  unfold HSConj.inter_simple\n  intro S T h1\n  simp_all [GT.TriangleFree, HS.Simple, HS.Bounded8]\nend HSP5\n",
   "source_sha256": "7a8134d7fd795e3460fb75b77c84b20effd2f290d3a2945a642bb74c0fae7b20",
   "trusted": false
  }
 ],
