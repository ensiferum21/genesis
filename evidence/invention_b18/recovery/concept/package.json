  {
   "name": "RCP3",
   "source": "import GTDefs\nimport HSDefs\nimport HSConj\nimport RCDefs\nimport RCConj\nimport RCP1\nimport RCP2\nnamespace RCP3\ntheorem proof : RCConj.instance_down_tf := by\n  unfold RCConj.instance_down_tf\n  rfl\nend RCP3\n",
   "source_sha256": "ce9f1c61f1118c0bb7fdbd3faeaad2a30e81b60fd3c1fd5527c253980690d900",
   "trusted": false
  },
  {
   "name": "RCP4",
   "source": "import GTDefs\nimport HSDefs\nimport HSConj\nimport RCDefs\nimport RCConj\nimport RCP1\nimport RCP2\nimport RCP3\nnamespace RCP4\ntheorem proof : RCConj.gen_concept_inter := by\n  unfold RCConj.gen_concept_inter\n  intro P h S T h1\n  exact h _ _ (by simp) h1\nend RCP4\n",
   "source_sha256": "6a1e492dd5c39b5754901393e9d4d9cd308b65f633b5bc3d70cc2969f72f974d",
   "trusted": false
  },
  {
   "name": "RCP5",
   "source": "import GTDefs\nimport HSDefs\nimport HSConj\nimport RCDefs\nimport RCConj\nimport RCP1\nimport RCP2\nimport RCP3\nimport RCP4\nnamespace RCP5\ntheorem proof : RCConj.gen_concept_sdiff := by\n  unfold RCConj.gen_concept_sdiff\n  intro P h S T h1\n  exact h _ _ (by simp) h1\nend RCP5\n",
   "source_sha256": "acc37362f6f7d814cdf2cbc2cf18651305157f7f902dfb10ec851e1f0311d8b4",
