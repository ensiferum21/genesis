 "domain": "edge-set predicates",
 "modules": [
  {
   "name": "GTDefs",
   "source": "import Mathlib.Data.Finset.Powerset\n\nnamespace GT\n\n/-- Edge sets: ordered pairs (u, v), read as the edge {u, v}. Hosts list each edge once, with u < v. -/\nabbrev Edges := Finset (ℕ × ℕ)\n\n/-- No three edges (a, b), (b, c), (a, c). -/\ndef TriangleFree (S : Edges) : Prop :=\n  ∀ e ∈ S, ∀ f ∈ S, ∀ g ∈ S, ¬ (e.1 = g.1 ∧ e.2 = f.1 ∧ f.2 = g.2)\n\ninstance (S : Edges) : Decidable (TriangleFree S) := by\n  unfold TriangleFree; infer_instance\n\nend GT\n",
   "source_sha256": "34a84d4f227cbf5a95012a37a9f263f14ca419a4959be42c674d8abc47c9e3a7",
   "trusted": true
  },
  {
   "name": "HSDefs",
   "source": "import GTDefs\n\nnamespace HS\n\n/-- History predicate: every pair is listed as (u, v) with u < v. -/\ndef Simple (S : GT.Edges) : Prop := ∀ e ∈ S, e.1 < e.2\n\n/-- History predicate: every endpoint is below 8. -/\ndef Bounded8 (S : GT.Edges) : Prop := ∀ e ∈ S, e.1 < 8 ∧ e.2 < 8\n\ninstance (S : GT.Edges) : Decidable (Simple S) := by unfold Simple; infer_instance\ninstance (S : GT.Edges) : Decidable (Bounded8 S) := by unfold Bounded8; infer_instance\n\nend HS\n",
   "source_sha256": "fda70a92d2893b0470ae39d2918fca1b195e1db384d6fedbbc1950b51e65d5db",
   "trusted": true
  },
  {
   "name": "HSConj",
   "source": "import GTDefs\nimport HSDefs\nset_option linter.unusedVariables false\n\nnamespace HSConj\n/-- Generated conjecture `down_tf` (history). -/\ndef down_tf : Prop := ∀ (S : GT.Edges) (T : GT.Edges) (h1 : T ⊆ S) (h2 : GT.TriangleFree S), GT.TriangleFree T\n/-- Generated conjecture `down_simple` (history). -/\ndef down_simple : Prop := ∀ (S : GT.Edges) (T : GT.Edges) (h1 : T ⊆ S) (h2 : HS.Simple S), HS.Simple T\n/-- Generated conjecture `down_bounded` (history). -/\ndef down_bounded : Prop := ∀ (S : GT.Edges) (T : GT.Edges) (h1 : T ⊆ S) (h2 : HS.Bounded8 S), HS.Bounded8 T\n/-- Generated conjecture `inter_tf` (history). -/\ndef inter_tf : Prop := ∀ (S : GT.Edges) (T : GT.Edges) (h1 : GT.TriangleFree S), GT.TriangleFree (S ∩ T)\n/-- Generated conjecture `inter_simple` (history). -/\ndef inter_simple : Prop := ∀ (S : GT.Edges) (T : GT.Edges) (h1 : HS.Simple S), HS.Simple (S ∩ T)\nend HSConj\n",
   "source_sha256": "b51522fc7800b90635c57f6e77ae907ef1f30cf3054ccf078472d4ad0d5b5040",
   "trusted": true
  },
  {
   "name": "RCDefs",
   "source": "import GTDefs\nimport HSDefs\n\nnamespace RC\n\n/-- Recovered by typed anti-unification of HSConj.down_bounded, HSConj.down_simple, HSConj.down_tf. -/\ndef C0 (P0 : GT.Edges -> Prop) : Prop := (∀ (x0 : @GT.Edges), (∀ (x1 : @GT.Edges), (∀ (x2 : (@LE.le @GT.Edges (@Preorder.toLE @GT.Edges (@PartialOrder.toPreorder @GT.Edges (@Finset.instPartialOrder (@Prod @Nat @Nat)))) x1 x0)), (∀ (x3 : (P0 x0)), (P0 x1)))))\n\nend RC\n",
   "source_sha256": "640f2b577f249cc93dd38a96935449b2cee5e8444b6040c263d712a4875931ae",
   "trusted": true
  },
  {
   "name": "RCConj",
   "source": "import GTDefs\nimport HSDefs\nimport HSConj\nimport RCDefs\nset_option linter.unusedVariables false\n\nnamespace RCConj\n/-- Generated conjecture `instance_down_bounded` (generated:reification-check). -/\ndef instance_down_bounded : Prop := @HSConj.down_bounded = @RC.C0 @HS.Bounded8\n/-- Generated conjecture `instance_down_simple` (generated:reification-check). -/\ndef instance_down_simple : Prop := @HSConj.down_simple = @RC.C0 @HS.Simple\n/-- Generated conjecture `instance_down_tf` (generated:reification-check). -/\ndef instance_down_tf : Prop := @HSConj.down_tf = @RC.C0 @GT.TriangleFree\n/-- Generated conjecture `gen_concept_inter` (generated:generic-over-concept). -/\ndef gen_concept_inter : Prop := ∀ (P : GT.Edges → Prop) (h : RC.C0 P) (S : GT.Edges) (T : GT.Edges) (h1 : P S), P (S ∩ T)\n/-- Generated conjecture `gen_concept_sdiff` (generated:generic-over-concept). -/\ndef gen_concept_sdiff : Prop := ∀ (P : GT.Edges → Prop) (h : RC.C0 P) (S : GT.Edges) (T : GT.Edges) (h1 : P S), P (S \\ T)\n/-- Generated conjecture `gen_concept_filter` (generated:generic-over-concept). -/\ndef gen_concept_filter : Prop := ∀ (P : GT.Edges → Prop) (h : RC.C0 P) (S : GT.Edges) (q : ℕ × ℕ → Bool) (h1 : P S), P (S.filter fun e => q e)\n/-- Generated conjecture `gen_concept_erase` (generated:generic-over-concept). -/\ndef gen_concept_erase : Prop := ∀ (P : GT.Edges → Prop) (h : RC.C0 P) (S : GT.Edges) (e : ℕ × ℕ) (h1 : P S), P (S.erase e)\nend RCConj\n",
   "source_sha256": "5487dc376e8ec689b148c6253649770d2c8647bd9ef9dd1ce0a21fbbed8c3b0f",
   "trusted": true
  },
  {
   "name": "RCP1",
   "source": "import GTDefs\nimport HSDefs\nimport HSConj\nimport RCDefs\nimport RCConj\nnamespace RCP1\ntheorem proof : RCConj.instance_down_bounded := by\n  unfold RCConj.instance_down_bounded\n  rfl\nend RCP1\n",
   "source_sha256": "a229acab6dac8cae85d20470b0938cc59b4cd93c4d6bc0b360dbe085f0fc8452",
   "trusted": false
  },
  {
   "name": "RCP2",
   "source": "import GTDefs\nimport HSDefs\nimport HSConj\nimport RCDefs\nimport RCConj\nimport RCP1\nnamespace RCP2\ntheorem proof : RCConj.instance_down_simple := by\n  unfold RCConj.instance_down_simple\n  rfl\nend RCP2\n",
