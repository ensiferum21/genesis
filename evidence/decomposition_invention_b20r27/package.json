 "domain": "triangle_free_host_v1",
 "modules": [
  {
   "name": "GTDefs",
   "source": "import Mathlib.Data.Finset.Powerset\n\nnamespace GT\n\n/-- Edge sets: ordered pairs (u, v), read as the edge {u, v}. Hosts list each edge once, with u < v. -/\nabbrev Edges := Finset (ℕ × ℕ)\n\n/-- No three edges (a, b), (b, c), (a, c). -/\ndef TriangleFree (S : Edges) : Prop :=\n  ∀ e ∈ S, ∀ f ∈ S, ∀ g ∈ S, ¬ (e.1 = g.1 ∧ e.2 = f.1 ∧ f.2 = g.2)\n\ninstance (S : Edges) : Decidable (TriangleFree S) := by\n  unfold TriangleFree; infer_instance\n\nend GT\n",
   "source_sha256": "34a84d4f227cbf5a95012a37a9f263f14ca419a4959be42c674d8abc47c9e3a7",
   "trusted": true
  },
  {
   "name": "DCConj",
   "source": "import GTDefs\nset_option linter.unusedVariables false\n\nnamespace DCConj\n/-- Generated conjecture `decomposition_union` (generated:decomposition-v1). -/\ndef decomposition_union : Prop := ∀ (S : GT.Edges) (T : GT.Edges) (hS : GT.TriangleFree S) (hT : GT.TriangleFree T) (hd : ∀ e ∈ S, ∀ f ∈ T, e.1 ≠ f.1 ∧ e.1 ≠ f.2 ∧ e.2 ≠ f.1 ∧ e.2 ≠ f.2), GT.TriangleFree (S ∪ T)\nend DCConj\n",
   "source_sha256": "5009d0bf45c964731f7d075d4b864aafd88d4d3ebf1df1162e43221503077ae1",
   "trusted": true
  },
  {
   "name": "DCP1",
   "source": "import GTDefs\nimport DCConj\nnamespace DCP1\ntheorem proof : DCConj.decomposition_union := by\n  unfold DCConj.decomposition_union\n  intro S T hS hT hd\n  unfold GT.TriangleFree at *\n  intro e he f hf g hg h\n  simp only [Finset.mem_union] at he hf hg\n  rcases he with he | he <;> rcases hf with hf | hf <;> rcases hg with hg | hg\n  all_goals first\n    | exact hS e he f hf g hg h\n    | exact hT e he f hf g hg h\n    | (have h1 := hd e he f hf; omega)\n    | (have h1 := hd e he g hg; omega)\n    | (have h1 := hd f hf e he; omega)\n    | (have h1 := hd f hf g hg; omega)\n    | (have h1 := hd g hg e he; omega)\n    | (have h1 := hd g hg f hf; omega)\nend DCP1\n",
   "source_sha256": "1f072b3ce18ac7165fd4cc029b9e30dfeb26840f34ecf8d0f02fdf9f50922b58",
   "trusted": false
  }
 ],
