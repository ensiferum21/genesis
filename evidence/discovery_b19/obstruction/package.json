 "domain": "triangle_free_host_v1, c4_host_v2",
 "modules": [
  {
   "name": "GTDefs",
   "source": "import Mathlib.Data.Finset.Powerset\n\nnamespace GT\n\n/-- Edge sets: ordered pairs (u, v), read as the edge {u, v}. Hosts list each edge once, with u < v. -/\nabbrev Edges := Finset (ℕ × ℕ)\n\n/-- No three edges (a, b), (b, c), (a, c). -/\ndef TriangleFree (S : Edges) : Prop :=\n  ∀ e ∈ S, ∀ f ∈ S, ∀ g ∈ S, ¬ (e.1 = g.1 ∧ e.2 = f.1 ∧ f.2 = g.2)\n\ninstance (S : Edges) : Decidable (TriangleFree S) := by\n  unfold TriangleFree; infer_instance\n\nend GT\n",
   "source_sha256": "34a84d4f227cbf5a95012a37a9f263f14ca419a4959be42c674d8abc47c9e3a7",
   "trusted": true
  },
  {
   "name": "G4Defs",
   "source": "import GTDefs\n\nnamespace G4\n\n/-- Domain contract (c4_host_v2): u and v are joined in S, in either orientation. -/\ndef adj (S : GT.Edges) (u v : ℕ) : Prop := (u, v) ∈ S ∨ (v, u) ∈ S\n\ninstance (S : GT.Edges) (u v : ℕ) : Decidable (adj S u v) := by\n  unfold adj; infer_instance\n\ndef verts (S : GT.Edges) : Finset ℕ := S.image Prod.fst ∪ S.image Prod.snd\n\n/-- No 4-cycle a-b-c-d-a with a ≠ c and b ≠ d. -/\ndef C4Free (S : GT.Edges) : Prop :=\n  ∀ a ∈ verts S, ∀ b ∈ verts S, ∀ c ∈ verts S, ∀ d ∈ verts S,\n    a ≠ c → b ≠ d → ¬ (adj S a b ∧ adj S b c ∧ adj S c d ∧ adj S d a)\n\ninstance (S : GT.Edges) : Decidable (C4Free S) := by\n  unfold C4Free; infer_instance\n\nend G4\n",
   "source_sha256": "bf94fb5d73cc9d32e1e11167df93df0ca356b3f1a6de0b050a8efe53bae7987b",
   "trusted": true
  },
  {
   "name": "OBConj",
   "source": "import GTDefs\nimport G4Defs\nset_option linter.unusedVariables false\n\nnamespace OBConj\n/-- Generated conjecture `tri_not_all` (generated:lp-inequality-validity). -/\ndef tri_not_all : Prop := ∀ (S : GT.Edges) (a : ℕ) (b : ℕ) (c : ℕ) (h1 : GT.TriangleFree S), ¬ ((a, b) ∈ S ∧ (b, c) ∈ S ∧ (a, c) ∈ S)\n/-- Generated conjecture `c4_not_all` (generated:lp-inequality-validity). -/\ndef c4_not_all : Prop := ∀ (S : GT.Edges) (a : ℕ) (b : ℕ) (c : ℕ) (d : ℕ) (h1 : G4.C4Free S) (h2 : a ≠ c) (h3 : b ≠ d), ¬ (G4.adj S a b ∧ G4.adj S b c ∧ G4.adj S c d ∧ G4.adj S d a)\nend OBConj\n",
   "source_sha256": "643aaf725f5934caf6c92265be6f1c320d4d2834f8ef6f963691456bfde9e12a",
   "trusted": true
  },
  {
   "name": "OBP1",
   "source": "import GTDefs\nimport G4Defs\nimport OBConj\nnamespace OBP1\ntheorem proof : OBConj.tri_not_all := by\n  unfold OBConj.tri_not_all\n  intro S a b c h1 h\n  unfold GT.TriangleFree at h1\n  exact h1 _ h.1 _ h.2.1 _ h.2.2 ⟨rfl, rfl, rfl⟩\nend OBP1\n",
   "source_sha256": "a8b7c156a91e46bb810de687a93dd9521554c66bbc474abb2a8d3b534485a651",
   "trusted": false
  },
  {
   "name": "OBP2",
   "source": "import GTDefs\nimport G4Defs\nimport OBConj\nimport OBP1\nnamespace OBP2\ntheorem proof : OBConj.c4_not_all := by\n  unfold OBConj.c4_not_all\n  intro S a b c d h1 h2 h3 h\n  apply h1 a ?_ b ?_ c ?_ d ?_ h2 h3 h\n  all_goals (unfold G4.verts G4.adj at *; simp only [Finset.mem_union, Finset.mem_image] at *)\n  all_goals aesop\nend OBP2\n",
   "source_sha256": "0f12c64beefaad63a258b3ba44c9b195012222c9c8b6dda9b6a95739a9233592",
   "trusted": false
  }
 ],
