  },
  {
   "name": "RLP4",
   "source": "import GTDefs\nimport RLDefs\nimport RLConj\nimport RLP1\nimport RLP2\nimport RLP3\nnamespace RLP4\ntheorem proof : RLConj.rel3_01021020_sound_tf := by\n  unfold RLConj.rel3_01021020_sound_tf\n  intro c H\n  unfold GT.TriangleFree RL.rel3_01021020\n  rintro ⟨a, b⟩ he ⟨b', d⟩ hf ⟨a', d'⟩ hg ⟨h1, h2, h3⟩\n  simp only [Finset.mem_filter] at he hf hg\n  simp only at h1 h2 h3\n  subst h1 h2 h3\n  have key : ∀ x y z : Fin 3, ¬ ((x.val, y.val) ∈ ([(0, 1), (0, 2), (1, 0), (2, 0)] : List (ℕ × ℕ)) ∧ (y.val, z.val) ∈ ([(0, 1), (0, 2), (1, 0), (2, 0)] : List (ℕ × ℕ)) ∧ (x.val, z.val) ∈ ([(0, 1), (0, 2), (1, 0), (2, 0)] : List (ℕ × ℕ))) := by decide\n  exact key _ _ _ ⟨he.2, hf.2, hg.2⟩\nend RLP4\n",
