 "domain": "triangle_free_host_v1",
 "modules": [
  {
   "name": "GTDefs",
   "source": "import Mathlib.Data.Finset.Powerset\n\nnamespace GT\n\n/-- Edge sets: ordered pairs (u, v), read as the edge {u, v}. Hosts list each edge once, with u < v. -/\nabbrev Edges := Finset (ℕ × ℕ)\n\n/-- No three edges (a, b), (b, c), (a, c). -/\ndef TriangleFree (S : Edges) : Prop :=\n  ∀ e ∈ S, ∀ f ∈ S, ∀ g ∈ S, ¬ (e.1 = g.1 ∧ e.2 = f.1 ∧ f.2 = g.2)\n\ninstance (S : Edges) : Decidable (TriangleFree S) := by\n  unfold TriangleFree; infer_instance\n\nend GT\n",
   "source_sha256": "34a84d4f227cbf5a95012a37a9f263f14ca419a4959be42c674d8abc47c9e3a7",
   "trusted": true
  },
  {
   "name": "RLDefs",
   "source": "import GTDefs\n\nnamespace RL\n\n/-- Generated relational decoder `rel2_0110` (generated:relation-enumeration-v1): host edges (u, v), u < v, whose class pair is one of 0→1, 1→0. -/\ndef rel2_0110 (c : ℕ → Fin 2) (H : GT.Edges) : GT.Edges := H.filter fun e => ((c e.1).val, (c e.2).val) ∈ ([(0, 1), (1, 0)] : List (ℕ × ℕ))\n\n/-- Generated relational decoder `rel3_01021020` (generated:relation-enumeration-v1): host edges (u, v), u < v, whose class pair is one of 0→1, 0→2, 1→0, 2→0. -/\ndef rel3_01021020 (c : ℕ → Fin 3) (H : GT.Edges) : GT.Edges := H.filter fun e => ((c e.1).val, (c e.2).val) ∈ ([(0, 1), (0, 2), (1, 0), (2, 0)] : List (ℕ × ℕ))\n\n/-- Generated relational decoder `rel3_011220` (generated:relation-enumeration-v1): host edges (u, v), u < v, whose class pair is one of 0→1, 1→2, 2→0. -/\ndef rel3_011220 (c : ℕ → Fin 3) (H : GT.Edges) : GT.Edges := H.filter fun e => ((c e.1).val, (c e.2).val) ∈ ([(0, 1), (1, 2), (2, 0)] : List (ℕ × ℕ))\n\nend RL\n",
   "source_sha256": "f1660aecdf485cdd5ef6567028a5bc771cd9c82b9e35dde3cb9b8a9d65bfe4e4",
   "trusted": true
  },
  {
   "name": "RLConj",
   "source": "import GTDefs\nimport RLDefs\nset_option linter.unusedVariables false\n\nnamespace RLConj\n/-- Generated conjecture `rel2_0110_image` (generated:relation-enumeration-v1). -/\ndef rel2_0110_image : Prop := ∀ (c : ℕ → Fin 2) (H : GT.Edges), RL.rel2_0110 c H ⊆ H\n/-- Generated conjecture `rel2_0110_sound_tf` (generated:relation-enumeration-v1). -/\ndef rel2_0110_sound_tf : Prop := ∀ (c : ℕ → Fin 2) (H : GT.Edges), GT.TriangleFree (RL.rel2_0110 c H)\n/-- Generated conjecture `rel3_01021020_image` (generated:relation-enumeration-v1). -/\ndef rel3_01021020_image : Prop := ∀ (c : ℕ → Fin 3) (H : GT.Edges), RL.rel3_01021020 c H ⊆ H\n/-- Generated conjecture `rel3_01021020_sound_tf` (generated:relation-enumeration-v1). -/\ndef rel3_01021020_sound_tf : Prop := ∀ (c : ℕ → Fin 3) (H : GT.Edges), GT.TriangleFree (RL.rel3_01021020 c H)\n/-- Generated conjecture `rel3_011220_image` (generated:relation-enumeration-v1). -/\ndef rel3_011220_image : Prop := ∀ (c : ℕ → Fin 3) (H : GT.Edges), RL.rel3_011220 c H ⊆ H\n/-- Generated conjecture `rel3_011220_sound_tf` (generated:relation-enumeration-v1). -/\ndef rel3_011220_sound_tf : Prop := ∀ (c : ℕ → Fin 3) (H : GT.Edges), GT.TriangleFree (RL.rel3_011220 c H)\nend RLConj\n",
   "source_sha256": "39d7d7161c52c1e2e92b514a3910bdbfd01742757b66880125b2b8eb4ee7f3f1",
   "trusted": true
  },
  {
   "name": "RLP1",
   "source": "import GTDefs\nimport RLDefs\nimport RLConj\nnamespace RLP1\ntheorem proof : RLConj.rel2_0110_image := by\n  unfold RLConj.rel2_0110_image\n  intro c H\n  simp_all [RL.rel2_0110]\nend RLP1\n",
   "source_sha256": "054346991e2759d770054e252654de83600c4104d88522ff1d9f10ca3977a69c",
   "trusted": false
  },
  {
   "name": "RLP2",
   "source": "import GTDefs\nimport RLDefs\nimport RLConj\nimport RLP1\nnamespace RLP2\ntheorem proof : RLConj.rel2_0110_sound_tf := by\n  unfold RLConj.rel2_0110_sound_tf\n  intro c H\n  unfold GT.TriangleFree RL.rel2_0110\n  rintro ⟨a, b⟩ he ⟨b', d⟩ hf ⟨a', d'⟩ hg ⟨h1, h2, h3⟩\n  simp only [Finset.mem_filter] at he hf hg\n  simp only at h1 h2 h3\n  subst h1 h2 h3\n  have key : ∀ x y z : Fin 2, ¬ ((x.val, y.val) ∈ ([(0, 1), (1, 0)] : List (ℕ × ℕ)) ∧ (y.val, z.val) ∈ ([(0, 1), (1, 0)] : List (ℕ × ℕ)) ∧ (x.val, z.val) ∈ ([(0, 1), (1, 0)] : List (ℕ × ℕ))) := by decide\n  exact key _ _ _ ⟨he.2, hf.2, hg.2⟩\nend RLP2\n",
   "source_sha256": "424dc7fff2ce8fbeac61ef5fff45d340683bca26794de95a38d3201d48dcc9e8",
   "trusted": false
  },
  {
   "name": "RLP3",
   "source": "import GTDefs\nimport RLDefs\nimport RLConj\nimport RLP1\nimport RLP2\nnamespace RLP3\ntheorem proof : RLConj.rel3_01021020_image := by\n  unfold RLConj.rel3_01021020_image\n  intro c H\n  simp_all [RL.rel3_01021020]\nend RLP3\n",
   "source_sha256": "77d41ee4fb37e83e37467a93eb98361290f52fa91e4fbc91c68afd70a970a3c5",
