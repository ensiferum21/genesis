\n  rw [hhand] at hcs\n  calc 4 * S.card ^ 2 = (2 * S.card) ^ 2 := by ring\n    _ ≤ (∑ v ∈ Finset.range n, ((Finset.range n).filter (fun w => G4.adj S v w)).card ^ 2) * n := hcs\n    _ ≤ (n * (n - 1) + 2 * S.card) * n := Nat.mul_le_mul_right n hQ\n    _ = n ^ 2 * (n - 1) + 2 * n * S.card := by ring\nend PCP2\n","source_sha256":"40b080b4a188b0539aa5aa4bf5273039ae4d7d47589f74f66e9f203ff8035174","trusted":false}],"name":"C4 pair-count bound (CRPD-2b)","package_sha256":"7e45d2889c5189f3cb50b4d037d7917fdd73ab22f002c73f0c026e8731ca55d2","proofs":[{"module":"PCP1","recipe":"pair-count-injection (builder-written)","statement":"pair_count_c4"},{"module":"PCP2","recipe":"handshake-cauchy-schwarz (builder-written)","statement":"c4_quadratic_bound"}],"provenance":{"acceptance":"genesis.formal_research.checker.accept","created_at":"2026-10-13T09:13:40.883634+00:00","loop":"genesis.formal_research.loop","search":"genesis.formal_research.search (builder-written recipes, named per proof)"},"schema":"genesis-theory-package-v1","scope":"every edge set S of ordered pairs u < v < n (the c4_host_v2 host contract)","statements":[{"axioms":["Classical.choice","Quot.sound","propext"],"counterexample":null,"id":"pair_count_c4","lean":"∀ (n : ℕ) (S : GT.Edges) (hS : ∀ e ∈ S, e.1 < e.2 ∧ e.2 < n) (hC : G4.C4Free S), ∑ v ∈ Finset.range n, (((Finset.range n).filter (fun w => G4.adj S v w)).card).choose 2 ≤ n.choose 2","origin":"builder-written (CRPD-2b): known counting bound, stated over the repository definitions","proof_const":"PCP1.proof","proof_module":"PCP1","recipe":"pair-count-injection (builder-written)","role":"bound","screened_instances":2724,"spec_const":"PCConj.pair_count_c4","status":"CHECKED","subject":"pair-count@c4_host_v2"},{"axioms":["Classical.choice","Quot.sound","propext"],"counterexample":null,"id":"c4_quadratic_bound","lean":"∀ (n : ℕ) (S : GT.Edges) (hS : ∀ e ∈ S, e.1 < e.2 ∧ e.2 < n) (hC : G4.C4Free S), 4 * S.card ^ 2 ≤ n ^ 2 * (n - 1) + 2 * n * S.card","origin":"builde