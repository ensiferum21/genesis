d4f227cbf5a95012a37a9f263f14ca419a4959be42c674d8abc47c9e3a7","trusted":true},{"name":"G4Defs","source":"import GTDefs\n\nnamespace G4\n\n/-- Domain contract (c4_host_v2): u and v are joined in S, in either orientation. -/\ndef adj (S : GT.Edges) (u v : ℕ) : Prop := (u, v) ∈ S ∨ (v, u) ∈ S\n\ninstance (S : GT.Edges) (u v : ℕ) : Decidable (adj S u v) := by\n  unfold adj; infer_instance\n\ndef verts (S : GT.Edges) : Finset ℕ := S.image Prod.fst ∪ S.image Prod.snd\n\n/-- No 4-cycle a-b-c-d-a with a ≠ c and b ≠ d. -/\ndef C4Free (S : GT.Edges) : Prop :=\n  ∀ a ∈ verts S, ∀ b ∈ verts S, ∀ c ∈ verts S, ∀ d ∈ verts S,\n    a ≠ c → b ≠ d → ¬ (adj S a b ∧ adj S b c ∧ adj S c d ∧ adj S d a)\n\ninstance (S : GT.Edges) : Decidable (C4Free S) := by\n  unfold C4Free; infer_instance\n\nend G4\n","source_sha256":"bf94fb5d73cc9d32e1e11167df93df0ca356b3f1a6de0b050a8efe53bae7987b","trusted":true},{"name":"PCImports","source":"import G4Defs\nimport Mathlib.Algebra.BigOperators.Group.Finset.Sigma\nimport Mathlib.Algebra.Order.BigOperators.Ring.Finset\n","source_sha256":"4854b8ac49dd950ec75e25a0664f26f44b5e8ea300f0765c2c5f7871f1c4e028","trusted":true},{"name":"PCConj","source":"import GTDefs\nimport G4Defs\nimport PCImports\nset_option linter.unusedVariables false\n\nnamespace PCConj\n/-- Generated conjecture `pair_count_c4` (builder-written (CRPD-2b): known counting bound, stated over the repository definitions). -/\ndef pair_count_c4 : Prop := ∀ (n : ℕ) (S : GT.Edges) (hS : ∀ e ∈ S, e.1 < e.2 ∧ e.2 < n) (hC : G4.C4Free S), ∑ v ∈ Finset.range n, (((Finset.range n).filter (fun w => G4.adj S v w)).card).choose 2 ≤ n.choose 2\n/-- Generated conjecture `c4_quadratic_bound` (builder-written (CRPD-2b): known counting bound, stated over the repository definitions). -/\ndef c4_quadratic_bound : Prop := ∀ (n : ℕ) (S : GT.Edges) (hS : ∀ e ∈ S, e.1 < e.2 ∧ e.2 < n) (hC : G4.C4Free S), 4 * S.card ^ 2 ≤ n ^ 2 * (n - 1) + 2 * n * S.card\nend PCConj\n","source_sha256":"ea2c1ec6855cc73f2e2b5a2670d0b8f32